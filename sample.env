# =====================================================================
# E-Training System — environment template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#
# Everything except the MICROSOFT_CLIENT_* section below is safe to ship to
# the browser (NEXT_PUBLIC_* — public identifiers, not secrets). Access
# control is enforced by firestore.rules, not by hiding these values.
#
# The one exception: MICROSOFT_CLIENT_ID / MICROSOFT_CLIENT_SECRET /
# MICROSOFT_TENANT_ID are real server-only secrets, used only by
# src/app/api/resolve-video (the one server route in this app) to resolve
# training-video SharePoint links. Never prefix these with NEXT_PUBLIC_.
# =====================================================================

# ---------------------------------------------------------------------
# Firebase Web SDK.
# Firebase console → Project settings → General → Your apps → SDK setup.
# ---------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ---------------------------------------------------------------------
# Microsoft sign-in (optional).
# Azure Portal → Microsoft Entra ID → App registrations → your app → Overview.
# Restricts "Continue with Microsoft" to this one Entra tenant (e.g. the
# school's tenant) instead of allowing any Microsoft account. Leave unset to
# allow any Microsoft/Entra account to attempt sign-in — unapproved emails
# are still rejected by firestore.rules either way.
# ---------------------------------------------------------------------
NEXT_PUBLIC_MICROSOFT_TENANT_ID=

# ---------------------------------------------------------------------
# Microsoft Graph, app-only (REQUIRED for training videos to play).
# Resolves each video's SharePoint share link to a direct, playable URL
# server-side, since SharePoint's own viewer can't be embedded for a
# signed-out visitor. Real secrets — server-only, never NEXT_PUBLIC_.
#
# One-time Azure setup (see SETUP.md for the full walkthrough):
#   1. Azure Portal → Microsoft Entra ID → App registrations → New registration.
#   2. API permissions → Add → Microsoft Graph → Application permissions →
#      Sites.Read.All → Add, then "Grant admin consent" (needs a tenant admin).
#   3. Certificates & secrets → New client secret → copy the VALUE (not the ID).
#   4. Overview page has the Application (client) ID and Directory (tenant) ID.
# ---------------------------------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# ---------------------------------------------------------------------
# NOTE: there is no admin-email variable here on purpose. The admin is
# defined ONLY in firestore.rules (the adminEmail() function), so the
# email never ships to the browser. The app detects admin status by
# capability (whether the signed-in user can read the admin-only
# allowlist), not by comparing emails on the client.
# ---------------------------------------------------------------------
