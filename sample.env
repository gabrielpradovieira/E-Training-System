# =====================================================================
# E-Training System — environment template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#
# This app is CLIENT-ONLY (no server secrets). Every value here is safe to
# ship to the browser. Access control is enforced by firestore.rules, not
# by hiding these values.
# =====================================================================

# ---------------------------------------------------------------------
# Firebase Web SDK.
# Firebase console → Project settings → General → Your apps → SDK setup.
# ---------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ---------------------------------------------------------------------
# EmailJS — sends the "you've been invited" email when a new teacher or
# student account is created (their login email + default password, and
# that they've been assigned to the Skills Challenge Preparation Course
# 2026). Free tier, no backend needed — fits this app's client-only model.
#
# 1. Create a free account at https://www.emailjs.com and connect an email
#    service (Gmail, Outlook, etc.) — this gives you the Service ID.
# 2. Create an email template with these variables in the subject/body:
#    {{to_name}}, {{to_email}}, {{role}}, {{login_email}},
#    {{login_password}}, {{course_name}} — this gives you the Template ID.
# 3. Account → General → find your Public Key.
# If any of these three are left unset, account creation still works —
# it just silently skips sending the invite email.
# ---------------------------------------------------------------------
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your-emailjs-service-id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your-emailjs-template-id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your-emailjs-public-key

# ---------------------------------------------------------------------
# NOTE: there is no admin-email variable here on purpose. The admin is
# defined ONLY in firestore.rules (the adminEmail() function), so the
# email never ships to the browser. The app detects admin status by
# capability (whether the signed-in user can read the admin-only
# allowlist), not by comparing emails on the client.
# ---------------------------------------------------------------------
