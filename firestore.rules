rules_version = '2';

// =====================================================================
// E-Training System — Firestore security rules (client-only model)
//
// Security model:
//  - Admin is the single ADMIN_EMAIL below. Set it to your admin's email.
//    (There is no server/Admin SDK in this model, so the admin email is
//    enforced here in the rules — this file IS the source of truth for it.)
//  - A user may read/write ONLY their own profile, and only if their email
//    is on the admin-managed `allowlist` (i.e. pre-approved) — or they are
//    the admin. Unapproved accounts can exist but can touch no data.
//  - Users cannot change their own role / approval / email.
//  - The allowlist and app config/media are admin-only for writes.
//  - Everything else is denied by default.
//
// >>> IMPORTANT: replace the email on the ADMIN_EMAIL line below, and keep
//     it in sync with NEXT_PUBLIC_ADMIN_EMAIL in your environment. <<<
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return isSignedIn() ? request.auth.token.email : "";
    }

    // The one admin account.
    function adminEmail() {
      return "oartevista@gmail.com";
    }

    function isAdmin() {
      return isSignedIn() && userEmail() == adminEmail();
    }

    // Pre-approved = an allowlist doc keyed by the user's (lower-case) email.
    function isApproved() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/allowlist/$(userEmail()));
    }

    function canUse() {
      return isApproved() || isAdmin();
    }

    // Fields a normal user may not change on their own profile.
    function protectedUnchanged() {
      return request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email
        && request.resource.data.approved == resource.data.approved;
    }

    match /users/{uid} {
      allow read:   if isAdmin() || (request.auth.uid == uid && canUse());
      // Non-admins may only create their own profile as a "student" —
      // the admin role can never be self-assigned.
      allow create: if isAdmin()
                    || (request.auth.uid == uid && canUse() && request.resource.data.role == 'student');
      allow update: if isAdmin()
                    || (request.auth.uid == uid && canUse() && protectedUnchanged());
      allow delete: if isAdmin();

      match /{sub=**} {
        allow read, write: if isAdmin() || (request.auth.uid == uid && canUse());
      }
    }

    // Admin-managed email allowlist.
    match /allowlist/{emailId} {
      allow read, write: if isAdmin();
    }

    // App-wide config: readable by approved users, writable by admin.
    match /config/{docId} {
      allow read:  if canUse();
      allow write: if isAdmin();
    }

    // Media references (SharePoint direct links), readable by approved users.
    match /media/{mediaId} {
      allow read:  if canUse();
      allow write: if isAdmin();
    }

    // Training material: Level -> Core Competence -> Competence Unit -> Videos.
    // Approved users read; only the admin builds them.
    match /cores/{coreId} {
      allow read:  if canUse();
      allow write: if isAdmin();
    }

    // Competence Units.
    match /sections/{sectionId} {
      allow read:  if canUse();
      allow write: if isAdmin();
    }

    // Training videos: approved users watch; only the admin manages them.
    match /videos/{videoId} {
      allow read:  if canUse();
      allow write: if isAdmin();
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
