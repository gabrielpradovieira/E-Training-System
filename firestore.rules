rules_version = '2';

// =====================================================================
// E-Training System — Firestore security rules (client-only model)
//
// Security model:
//  - Admin is the single ADMIN_EMAIL below. Set it to your admin's email.
//    (There is no server/Admin SDK in this model, so the admin email is
//    enforced here in the rules — this file IS the source of truth for it.)
//  - Three roles: admin, teacher, student.
//    - Admin can read/write anything.
//    - Teacher can create student accounts (role must be 'student', and
//      createdBy must be the teacher's own uid) and read/list only the
//      students they created.
//    - A student may read only their own profile.
//  - A user counts as "approved" either via the legacy allowlist doc, or
//    because their own profile document already has approved == true —
//    every account an admin/teacher provisions is created with
//    approved: true set directly, so it never needs an allowlist entry.
//  - Users cannot change their own role / approval / email.
//  - The allowlist and app config/media are admin-only for writes.
//  - Everything else is denied by default.
//
// >>> IMPORTANT: replace the email on the ADMIN_EMAIL line below, and keep
//     it in sync with NEXT_PUBLIC_ADMIN_EMAIL in your environment. <<<
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return isSignedIn() ? request.auth.token.email : "";
    }

    // The one admin account.
    function adminEmail() {
      return "oartevista@gmail.com";
    }

    function isAdmin() {
      return isSignedIn() && userEmail() == adminEmail();
    }

    function ownProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTeacher() {
      return isSignedIn() && ownProfile().role == 'teacher';
    }

    // Pre-approved = an allowlist doc keyed by the user's (lower-case) email
    // (legacy self-registration path), OR the caller's own profile already
    // has approved == true (the path every admin/teacher-provisioned
    // account takes).
    function isApproved() {
      return isSignedIn()
        && (exists(/databases/$(database)/documents/allowlist/$(userEmail()))
            || ownProfile().approved == true);
    }

    function canUse() {
      return isApproved() || isAdmin();
    }

    // Fields a normal user may not change on their own profile.
    function protectedUnchanged() {
      return request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email
        && request.resource.data.approved == resource.data.approved;
    }

    match /users/{uid} {
      // A teacher sees their own profile plus every student at their own
      // school (not only the ones they personally created), but never a
      // student — or another teacher — from a different school.
      allow read:   if isAdmin()
                    || (request.auth.uid == uid && canUse())
                    || (isTeacher()
                        && resource.data.role == 'student'
                        && resource.data.school == ownProfile().school);

      // Three ways a profile document can be created:
      //  - admin: no restrictions
      //  - self-registration (legacy): the signer creates their own doc as 'student'
      //  - teacher provisioning: a teacher creates a *student* they own (createdBy == teacher)
      allow create: if isAdmin()
                    || (request.auth.uid == uid && canUse() && request.resource.data.role == 'student')
                    || (isTeacher()
                        && request.resource.data.role == 'student'
                        && request.resource.data.createdBy == request.auth.uid);

      allow update: if isAdmin()
                    || (request.auth.uid == uid && canUse() && protectedUnchanged())
                    // A teacher may edit (name/school/password) a student they
                    // created, but can't reassign its role or ownership.
                    || (isTeacher()
                        && resource.data.role == 'student'
                        && resource.data.createdBy == request.auth.uid
                        && request.resource.data.role == 'student'
                        && request.resource.data.createdBy == request.auth.uid);
      // A teacher may also delete a student account they created.
      allow delete: if isAdmin()
                    || (isTeacher()
                        && resource.data.role == 'student'
                        && resource.data.createdBy == request.auth.uid);

      match /{sub=**} {
        // A teacher may also read (never write) a same-school student's
        // subcollections — this is how "Students Progress" reads each
        // student's saved training-progress doc.
        allow read:  if isAdmin()
                     || (request.auth.uid == uid && canUse())
                     || (isTeacher()
                         && get(/databases/$(database)/documents/users/$(uid)).data.role == 'student'
                         && get(/databases/$(database)/documents/users/$(uid)).data.school == ownProfile().school);
        allow write: if isAdmin() || (request.auth.uid == uid && canUse());
      }
    }

    // Admin-managed email allowlist.
    match /allowlist/{emailId} {
      allow read, write: if isAdmin();
    }

    // App-wide config: readable by approved users, writable by admin.
    match /config/{docId} {
      allow read:  if canUse();
      allow write: if isAdmin();
    }

    // Media references (SharePoint direct links), readable by approved users.
    match /media/{mediaId} {
      allow read:  if canUse();
      allow write: if isAdmin();
    }

    // Curriculum tasks attached to a lesson (name + external link). Anyone
    // approved can see them; only admin creates/edits/removes them. A
    // student's own completion of a task lives at
    // users/{uid}/taskCompletions/{taskId}, covered by the users/{uid}
    // subcollection rule above (owner read/write, teacher read-only for
    // their own school, admin everything).
    match /tasks/{taskId} {
      allow read:  if canUse();
      allow write: if isAdmin();
    }

    // Legacy/unused-by-current-code collections, kept from the prior rules
    // as-is (nothing in the app reads or writes these right now).
    match /cores/{coreId} {
      allow read:  if canUse();
      allow write: if isAdmin();
    }

    match /sections/{sectionId} {
      allow read:  if canUse();
      allow write: if isAdmin();
    }

    match /videos/{videoId} {
      allow read:  if canUse();
      allow write: if isAdmin();
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
